# ---------------------------------------------------------------
# Copy to .env.local (gitignored) and fill in. On Vercel, set the
# same keys under Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Vercel Blob — project demo videos (scripts/upload-videos-to-blob.mjs)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# ---------------------------------------------------------------
# SMTP — /contact enquiry delivery (app/api/contact/route.js)
#
# Any SMTP provider works. Two common shapes:
#   Google Workspace   host smtp.gmail.com     port 587, an App Password
#                      (2FA must be on; your normal password is rejected)
#   Amazon SES         host email-smtp.<region>.amazonaws.com  port 587,
#                      SMTP credentials generated in the SES console
#   Microsoft 365      host smtp.office365.com port 587
# ---------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
# 587 for STARTTLS (usual), 465 for implicit TLS
SMTP_PORT=587
# "true" ONLY on port 465. Leave empty and the port decides.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered. Comma-separated for several recipients.
CONTACT_TO=contact@aibrigade.ai

# The From address. It must be one the SMTP account is authorised to send
# as, or the provider will reject the message — the visitor's own address
# goes in Reply-To instead, which is what keeps SPF/DKIM aligned.
CONTACT_FROM=AI Brigade Website <contact@aibrigade.ai>

# "true" also sends the visitor a short acknowledgement of their message.
CONTACT_AUTOREPLY=false
